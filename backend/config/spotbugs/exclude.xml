<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Spring injiziert unveränderliche Beans per Konstruktor; Record-Accessoren geben Listen bewusst weiter. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!-- Spring-Konfigurationsklassen dürfen im Konstruktor Beans übernehmen. -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
